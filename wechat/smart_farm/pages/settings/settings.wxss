/* pages/settings/settings.wxss —— 阈值设置页局部样式，通用类复用 app.wxss */

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.section-head .card-title {
  margin-bottom: 0;
}

.field-row {
  display: flex;
  align-items: flex-start;
}

.field-row .field {
  flex: 1;
  min-width: 0;
}

.field-row .field + .field {
  margin-left: 24rpx;
}

.banner-hint {
  margin-top: 6rpx;
  font-size: 24rpx;
  opacity: 0.85;
}

.conflict-box {
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  background: #fff4e5;
}

.conflict-box .note {
  color: #8a5300;
}

.conflict-btn {
  margin-top: 16rpx;
}

.btn-ghost[disabled] {
  color: #a9c9b6;
  border-color: #d9e2d7;
}

.flame-unavailable {
  margin-top: 16rpx;
  margin-bottom: 20rpx;
}

.status {
  margin-top: 18rpx;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  background: #f6f8f5;
  font-size: 24rpx;
  line-height: 1.6;
  color: #4a5a4e;
  word-break: break-all;
}

.status-muted {
  color: #7a8579;
}

.status-ok {
  background: #e8f5ec;
  color: #2f7d4f;
}

.status-warn {
  background: #fff4e5;
  color: #8a5300;
}

.status-err {
  background: #fdeaea;
  color: #b3261e;
}

.status-hint {
  margin-top: 6rpx;
  opacity: 0.82;
}
