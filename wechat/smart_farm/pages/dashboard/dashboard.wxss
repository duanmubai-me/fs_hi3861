/* pages/dashboard/dashboard.wxss —— 总览页局部差异样式；通用类复用 app.wxss */

/* ---------- 顶部 banner ---------- */
.dash-banner-note {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.6;
}

/* ---------- hero：文字在上、刷新按钮在最底部 ---------- */
.dash-hero-body {
  display: flex;
  flex-direction: column;
}

.dash-hero-kicker {
  font-size: 22rpx;
  letter-spacing: 2rpx;
  color: var(--color-muted-foreground);
}

/* danger hero 的浅红底上，muted 对比度不足，关键的小字改用 foreground */
.dash-hero-kicker-danger {
  color: var(--color-foreground);
}

.dash-hero-title {
  margin-top: 8rpx;
  word-break: break-word;
}

.dash-hero-meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  margin-top: 12rpx;
  font-size: 24rpx;
}

.dash-hero-meta-text {
  font-weight: 500;
}

.dash-hero-sep {
  margin: 0 12rpx;
  color: var(--color-muted-foreground);
}

.dash-hero-refresh {
  width: 100%;
  min-height: 88rpx;
  margin-top: 28rpx;
  font-size: 28rpx;
}

/* 全局 .btn[disabled] 会改成白字，ghost 按钮在浅色底上需保持可读 */
.dash-hero-refresh[disabled] {
  color: var(--color-muted-foreground);
  border-color: var(--color-border);
  background: var(--color-surface);
}

/* danger hero 的柔光也跟随报警色，避免绿色光晕出现在红色 hero 里 */
.hero-danger::after {
  background: radial-gradient(circle, rgba(220, 38, 38, 0.16) 0%, rgba(220, 38, 38, 0) 70%);
}

.dash-hero-alarm {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(220, 38, 38, 0.25);
}

.dash-hero-alarm-title {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--color-destructive);
}

.dash-hero-alarm-text {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.7;
}

.dash-hero-alarm-btn {
  margin-top: 20rpx;
}

/* ---------- 环境数据 ---------- */
.dash-data {
  margin-bottom: 24rpx;
}

.dash-humidity {
  flex: 1;
}

.dash-temperature {
  flex: 1;
}

/* 两张数据卡等宽等高、相同排版：标签 → 大数字+单位 → 同一位置的底行说明 */
.dash-data {
  align-items: stretch;
}

.dash-data .stat-card {
  display: flex;
  flex-direction: column;
  min-height: 292rpx;
  padding-bottom: 24rpx;
  box-sizing: border-box;
}

.dash-humidity .stat-value-lg,
.dash-temperature .stat-value-lg {
  font-size: 88rpx;
}

.dash-value-line {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  margin-top: 8rpx;
}

.dash-humidity .stat-value-lg {
  color: var(--color-primary);
}

.dash-humidity .stat-value-lg.dash-value-muted {
  color: var(--color-muted-foreground);
}

.dash-value-muted {
  color: var(--color-muted-foreground);
}

.dash-quality {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  min-height: 44rpx;
  margin-top: 16rpx;
}

.dash-quality-kind {
  font-size: 22rpx;
  line-height: 1.5;
}

.dash-quality-note {
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: var(--color-accent);
}

.dash-sampled {
  display: flex;
  align-items: center;
  min-height: 44rpx;
  margin-top: 16rpx;
  font-size: 22rpx;
  line-height: 1.5;
}

/* ---------- 控制卡 ---------- */
.dash-switch-row {
  min-height: 112rpx;
}

.dash-switch-row + .dash-switch-row,
.dash-inline-error + .dash-switch-row {
  border-top: 1rpx solid var(--color-border);
}

.dash-switch-label {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  padding: 8rpx 0;
}

.dash-switch-desc {
  margin-top: 4rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: var(--color-muted-foreground);
}

.dash-inline-error {
  margin-top: 0;
  padding-bottom: 8rpx;
}

.dash-lock-note {
  margin-top: 16rpx;
  padding-left: 20rpx;
  border-left: 4rpx solid var(--color-accent);
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--color-accent);
}

/* ---------- 快捷入口 2×2 ---------- */
.dash-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx;
}

.dash-tile {
  width: calc(50% - 12rpx);
  min-height: 136rpx;
  padding: 24rpx;
  box-sizing: border-box;
  background: var(--color-surface);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-sm);
  transition: background-color var(--motion-fast), box-shadow var(--motion-fast);
}

.dash-tile-pressed {
  background: var(--color-background);
}

.dash-tile-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.dash-tile-title {
  font-size: 30rpx;
  font-weight: 600;
}

.dash-tile-arrow {
  font-size: 34rpx;
  line-height: 1;
  color: var(--color-primary);
}

.dash-tile-desc {
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: var(--color-muted-foreground);
}

.dash-links-note {
  margin: 16rpx 8rpx 24rpx;
}

/* ---------- 最近回执 ---------- */
.dash-receipt-head {
  min-height: 64rpx;
}

.dash-receipt-head .chip {
  margin-right: 0;
}

.dash-receipt-text {
  margin-top: 4rpx;
  line-height: 1.7;
  color: var(--color-foreground);
  word-break: break-all;
}

/* ---------- 空态重试 ---------- */
.dash-retry {
  margin-top: 24rpx;
}
