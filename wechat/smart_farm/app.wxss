/* app.wxss —— 全局设计系统（UI-UX Pro Max: Agriculture/Farm Tech × Organic Biophilic, light-first）
 * 规范见 docs/ui-spec.md；页面只写差异样式，优先复用这里的类。
 */
page {
  --color-primary: #15803d;
  --color-primary-strong: #166534;
  --color-on-primary: #ffffff;
  --color-secondary: #22c55e;
  --color-accent: #a16207;
  --color-background: #f0fdf4;
  --color-surface: #ffffff;
  --color-foreground: #14532d;
  --color-muted: #e8f0f1;
  --color-muted-foreground: #64748b;
  --color-border: #bbf7d0;
  --color-destructive: #dc2626;
  --color-warn-bg: #fef3c7;
  --color-danger-bg: #fee2e2;
  --color-ok-bg: #dcfce7;
  --radius-sm: 16rpx;
  --radius-md: 32rpx;
  --radius-lg: 48rpx;
  --radius-pill: 999rpx;
  --shadow-sm: 0 2rpx 8rpx rgba(20, 83, 45, 0.06);
  --shadow-md: 0 8rpx 24rpx rgba(20, 83, 45, 0.08);
  --shadow-lg: 0 16rpx 40rpx rgba(20, 83, 45, 0.1);
  --motion-fast: 160ms ease-out;
  --motion-base: 220ms ease-out;

  background: var(--color-background);
  color: var(--color-foreground);
  font-size: 28rpx;
  line-height: 1.5;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", "Noto Sans SC",
    sans-serif;
}

.page {
  padding: 32rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* 兼容旧页面根节点类名；新页面统一用 .page */
.container {
  padding: 32rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.unit {
  font-size: 24rpx;
  color: var(--color-muted-foreground);
  margin-left: 8rpx;
}

.value.large {
  font-size: 64rpx;
  font-weight: 700;
  line-height: 1.1;
  color: var(--color-primary);
}

/* ---------- 卡片 ---------- */
.card {
  background: var(--color-surface);
  border-radius: var(--radius-md);
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-md);
  border: 1rpx solid rgba(187, 247, 208, 0.6);
  box-sizing: border-box;
}

.hero {
  position: relative;
  overflow: hidden;
  background: linear-gradient(135deg, #dcfce7 0%, #f0fdf4 55%, #ffffff 100%);
  border-radius: var(--radius-lg);
  padding: 40rpx 32rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-lg);
  border: 1rpx solid rgba(187, 247, 208, 0.8);
}

.hero::after {
  content: "";
  position: absolute;
  right: -80rpx;
  top: -110rpx;
  width: 300rpx;
  height: 300rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(34, 197, 94, 0.18) 0%, rgba(34, 197, 94, 0) 70%);
  pointer-events: none;
}

.hero-danger {
  background: linear-gradient(135deg, #fee2e2 0%, #fff5f5 60%, #ffffff 100%);
  border-color: rgba(220, 38, 38, 0.25);
  box-shadow: 0 16rpx 40rpx rgba(220, 38, 38, 0.12);
}

.hero-title {
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.hero-subtitle {
  font-size: 24rpx;
  color: var(--color-muted-foreground);
  margin-top: 8rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.card-subtitle {
  font-size: 24rpx;
  color: var(--color-muted-foreground);
  margin-bottom: 16rpx;
}

.section-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-muted-foreground);
  margin: 32rpx 8rpx 16rpx;
  letter-spacing: 1rpx;
}

/* ---------- 数据展示 ---------- */
.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 88rpx;
  padding: 12rpx 0;
}

.row + .row {
  border-top: 1rpx solid rgba(187, 247, 208, 0.7);
}

.row-left {
  display: flex;
  align-items: center;
  min-width: 0;
}

.row-right {
  display: flex;
  align-items: center;
  flex-shrink: 0;
}

.label {
  color: var(--color-muted-foreground);
}

.value {
  font-weight: 600;
}

.text-mono {
  font-family: Menlo, Consolas, "Courier New", monospace;
  font-size: 24rpx;
  letter-spacing: 0;
}

.stat-grid {
  display: flex;
  gap: 24rpx;
}

.stat-card {
  flex: 1;
  min-width: 0;
  background: var(--color-surface);
  border-radius: var(--radius-md);
  padding: 28rpx 24rpx;
  box-shadow: var(--shadow-sm);
  border: 1rpx solid rgba(187, 247, 208, 0.6);
  box-sizing: border-box;
}

.stat-label {
  font-size: 24rpx;
  color: var(--color-muted-foreground);
}

.stat-value {
  font-size: 56rpx;
  font-weight: 700;
  line-height: 1.15;
  margin-top: 8rpx;
  font-variant-numeric: tabular-nums;
}

.stat-value-lg {
  font-size: 96rpx;
  font-weight: 700;
  line-height: 1.05;
  font-variant-numeric: tabular-nums;
  letter-spacing: -1rpx;
}

.stat-unit {
  font-size: 24rpx;
  color: var(--color-muted-foreground);
  margin-left: 8rpx;
  font-weight: 400;
}

.muted {
  color: var(--color-muted-foreground);
}

.note {
  font-size: 24rpx;
  color: var(--color-muted-foreground);
  line-height: 1.7;
}

.text-danger {
  color: var(--color-destructive);
}

.text-warn {
  color: var(--color-accent);
}

/* ---------- 状态点 / chip / badge ---------- */
.dot {
  display: inline-block;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.dot-ok {
  background: var(--color-secondary);
}

.dot-warn {
  background: var(--color-accent);
}

.dot-danger {
  background: var(--color-destructive);
}

.dot-muted {
  background: var(--color-muted-foreground);
}

.chip {
  display: inline-flex;
  align-items: center;
  height: 44rpx;
  padding: 0 18rpx;
  border-radius: var(--radius-pill);
  background: var(--color-muted);
  color: var(--color-muted-foreground);
  font-size: 22rpx;
  line-height: 1;
  margin-right: 12rpx;
}

.chip-ok {
  background: var(--color-ok-bg);
  color: var(--color-primary-strong);
}

.chip-warn {
  background: var(--color-warn-bg);
  color: #8a5300;
}

.chip-danger {
  background: var(--color-danger-bg);
  color: #b3261e;
}

.badge {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: var(--radius-pill);
  font-size: 22rpx;
  line-height: 1.6;
}

.badge-ok {
  background: var(--color-ok-bg);
  color: var(--color-primary-strong);
}

.badge-warn {
  background: var(--color-warn-bg);
  color: #8a5300;
}

.badge-err {
  background: var(--color-danger-bg);
  color: #b3261e;
}

.badge-muted {
  background: var(--color-muted);
  color: var(--color-muted-foreground);
}

/* ---------- banner ---------- */
.banner {
  padding: 20rpx 24rpx;
  border-radius: var(--radius-md);
  font-size: 26rpx;
  line-height: 1.6;
  margin-bottom: 24rpx;
}

.banner-ok {
  background: var(--color-ok-bg);
  color: var(--color-primary-strong);
}

.banner-warn {
  background: var(--color-warn-bg);
  color: #8a5300;
}

.banner-err {
  background: var(--color-danger-bg);
  color: #b3261e;
}

.banner-title {
  font-weight: 600;
  margin-bottom: 4rpx;
}

/* ---------- 按钮 ---------- */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  /* 微信原生 button 默认宽度约 184px，必须显式覆盖为整行宽度 */
  width: 100% !important;
  margin: 0;
  padding: 0 32rpx;
  min-height: 88rpx;
  border-radius: var(--radius-md);
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
  background: var(--color-surface);
  color: var(--color-foreground);
  border: 2rpx solid var(--color-border);
  box-sizing: border-box;
  transition: background-color var(--motion-fast), opacity var(--motion-fast);
}

.btn::after {
  border: none;
}

.btn-primary {
  background: var(--color-primary);
  border-color: var(--color-primary);
  color: var(--color-on-primary);
}

.btn-ghost {
  background: var(--color-surface);
  color: var(--color-primary);
  border-color: var(--color-border);
}

.btn-danger {
  background: var(--color-destructive);
  border-color: var(--color-destructive);
  color: #ffffff;
}

.btn-outline-danger {
  background: #ffffff;
  color: var(--color-destructive);
  border-color: rgba(220, 38, 38, 0.4);
}

.btn-pressed {
  opacity: 0.88;
}

.btn[disabled],
.btn-disabled {
  opacity: 0.45;
  color: #ffffff;
}

.btn-primary[disabled] {
  background: #4d9a6a;
  border-color: #4d9a6a;
}

.btn + .btn {
  margin-top: 20rpx;
}

.btn-mini {
  display: inline-flex;
  width: auto !important;
  min-height: 60rpx;
  padding: 0 26rpx;
  font-size: 24rpx;
  border-radius: var(--radius-pill);
}

/* ---------- 表单 ---------- */
.field {
  margin-bottom: 24rpx;
}

.field-label {
  display: block;
  font-size: 26rpx;
  font-weight: 500;
  color: var(--color-foreground);
  margin-bottom: 12rpx;
}

.input {
  height: 88rpx;
  padding: 0 24rpx;
  border: 2rpx solid var(--color-border);
  border-radius: 20rpx;
  background: #fbfdfa;
  font-size: 30rpx;
  box-sizing: border-box;
  transition: border-color var(--motion-fast), box-shadow var(--motion-fast);
}

.input-focus {
  border-color: var(--color-primary);
  box-shadow: 0 0 0 3rpx rgba(21, 128, 61, 0.15);
}

.input-error {
  border-color: var(--color-destructive);
}

.field-error {
  font-size: 24rpx;
  color: var(--color-destructive);
  margin-top: 10rpx;
}

.field-hint {
  font-size: 22rpx;
  color: var(--color-muted-foreground);
  margin-top: 10rpx;
  line-height: 1.6;
}

.input-row {
  display: flex;
  gap: 24rpx;
}

.input-row .field {
  flex: 1;
  min-width: 0;
}

/* ---------- 步骤条 ---------- */
.stepper {
  padding-left: 8rpx;
}

.step {
  display: flex;
  align-items: flex-start;
  min-height: 72rpx;
}

.step-rail {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 32rpx;
  margin-right: 20rpx;
}

.step-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: var(--color-border);
  margin-top: 10rpx;
  transition: background-color var(--motion-base);
}

.step-dot-done {
  background: var(--color-secondary);
}

.step-dot-current {
  background: var(--color-primary);
  box-shadow: 0 0 0 6rpx rgba(21, 128, 61, 0.15);
}

.step-dot-error {
  background: var(--color-destructive);
}

.step-line {
  flex: 1;
  width: 2rpx;
  background: var(--color-border);
  margin-top: 4rpx;
}

.step-body {
  flex: 1;
  min-width: 0;
  padding-bottom: 20rpx;
}

.step-title {
  font-size: 26rpx;
  font-weight: 500;
}

.step-detail {
  font-size: 22rpx;
  color: var(--color-muted-foreground);
  margin-top: 4rpx;
  line-height: 1.6;
}

/* ---------- 进度条（火焰原始值等） ---------- */
.bar {
  position: relative;
  height: 12rpx;
  border-radius: var(--radius-pill);
  background: var(--color-muted);
  overflow: hidden;
  margin: 16rpx 0;
}

.bar-fill {
  height: 100%;
  border-radius: var(--radius-pill);
  background: linear-gradient(90deg, #22c55e 0%, #15803d 100%);
  transition: width var(--motion-base);
}

.bar-danger {
  background: linear-gradient(90deg, #f59e0b 0%, #dc2626 100%);
}

.bar-mark {
  position: absolute;
  top: -4rpx;
  bottom: -4rpx;
  width: 4rpx;
  background: var(--color-accent);
  border-radius: 2rpx;
}

.bar-labels {
  display: flex;
  justify-content: space-between;
  font-size: 22rpx;
  color: var(--color-muted-foreground);
}

/* ---------- 代码块 / 技术信息 ---------- */
.code-block {
  background: #14532d;
  color: #dcfce7;
  border-radius: 24rpx;
  padding: 24rpx;
  font-family: Menlo, Consolas, "Courier New", monospace;
  font-size: 22rpx;
  line-height: 1.7;
  word-break: break-all;
}

.code-scroll {
  max-height: 520rpx;
  border-radius: 24rpx;
  overflow: hidden;
}

/* ---------- mock 区 ---------- */
.mock-panel {
  background: #f8fafc;
  border: 2rpx dashed rgba(100, 116, 139, 0.45);
  border-radius: var(--radius-md);
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.mock-panel-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
}

/* ---------- 通用布局 ---------- */
.flex {
  display: flex;
  align-items: center;
}

.flex-1 {
  flex: 1;
  min-width: 0;
}

.gap-16 {
  gap: 16rpx;
}

.gap-24 {
  gap: 24rpx;
}

.mt-16 {
  margin-top: 16rpx;
}

.mt-24 {
  margin-top: 24rpx;
}

.mt-32 {
  margin-top: 32rpx;
}

.mb-0 {
  margin-bottom: 0;
}

.divider {
  height: 1rpx;
  background: rgba(187, 247, 208, 0.8);
  margin: 24rpx 0;
}

.empty {
  padding: 64rpx 0;
  text-align: center;
  color: var(--color-muted-foreground);
  font-size: 26rpx;
}

.link-text {
  color: var(--color-primary);
  font-size: 26rpx;
  font-weight: 500;
}
